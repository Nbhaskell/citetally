#!/bin/sh
# Blocks personal information and committed secrets. Enable once per clone:
#   git config core.hooksPath .githooks
#   python tools/secret_scan.py --fetch     (downloads the pinned gitleaks into .tools/)
# Both checkers use only the standard library, so any Python works.
for py in .venv/Scripts/python.exe .venv/bin/python python3 python; do
  if command -v "$py" >/dev/null 2>&1; then
    "$py" tools/check_personal_info.py --staged || exit 1
    exec "$py" tools/secret_scan.py --staged
  fi
done
echo "pre-commit: no Python found, so the personal-information and secret checks did not run." >&2
exit 1
