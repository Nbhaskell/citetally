# Copy to .env and adjust. Settings owned by this project use the CITETALLY_ prefix.
# See docs/TRD.md section 8. Only the settings used so far are listed; later phases add the rest.

# --- Service ---
CITETALLY_PORT=8200
CITETALLY_DB_PATH=data/citetally.db
CITETALLY_DATA_DIR=data

# --- Model (local first) ---
CITETALLY_MODEL_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
CITETALLY_TEXT_MODEL=qwen3:8b
# Empty means the vision model is disabled.
CITETALLY_VISION_MODEL=

# --- OCR ---
CITETALLY_OCR_ENGINE=tesseract
# Leave empty to find tesseract on PATH or in the default Windows install folder.
TESSERACT_CMD=

# --- Upload limits (anything over a limit fails at ingest with a plain reason) ---
CITETALLY_MAX_FILE_MB=20
CITETALLY_MAX_PAGES=10
# Pixel cap for images and rendered pages, to defeat decompression bombs.
CITETALLY_MAX_IMAGE_PIXELS=40000000
# A PDF page with at least this many characters of text is read from its text layer.
CITETALLY_TEXT_LAYER_MIN_CHARS=80

# --- Grounding and parsing ---
# How closely printed text must match the page words (0 to 1). A changed digit never matches.
CITETALLY_GROUNDING_MATCH_THRESHOLD=0.85
# What a bare "$" means, and the date and number format used to resolve ambiguous values.
CITETALLY_DEFAULT_CURRENCY=USD
CITETALLY_LOCALE=en-US

# --- Safety switches ---
# Hosted models are off by default. Hosted mode refuses to start unless this is true.
CITETALLY_ALLOW_HOSTED=false
# Shows the "Demo data" label in the UI. All data in this project is synthetic.
CITETALLY_SYNTHETIC_DATA=true
