# Copy to .env and adjust. Settings owned by this project use the CITETALLY_ prefix.
# See docs/TRD.md section 8. Only the settings used so far are listed; later phases add the rest.

# --- Service ---
CITETALLY_PORT=8200
CITETALLY_DB_PATH=data/citetally.db
CITETALLY_DATA_DIR=data

# --- Model (local first) ---
CITETALLY_MODEL_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
CITETALLY_TEXT_MODEL=qwen3:8b
# The model that also sees page pictures. Empty turns pictures off. Pull it once: ollama pull qwen3-vl:8b-instruct
CITETALLY_VISION_MODEL=qwen3-vl:8b-instruct
# auto: a PDF with a text layer is read as text; a scan or photo is read with its picture (and falls back to
# text if the vision model is missing or slow). text_only: never use pictures. text_and_image: always.
CITETALLY_EXTRACT_MODE=auto
# How many ways each scanned page is read (1 to 3). More readings find more of the page's values; slower.
CITETALLY_OCR_READINGS=3
# Let the model think before it answers. Slower; measured in the evaluation. Raise the token budget with it.
CITETALLY_ENABLE_THINKING=false
CITETALLY_EXTRACT_MAX_TOKENS=2000
CITETALLY_EXTRACT_TIMEOUT_S=180

# --- OCR ---
# tesseract, or rapidocr (optional: pip install -r requirements-rapidocr.txt; see D-073).
CITETALLY_OCR_ENGINE=tesseract
# Leave empty to find tesseract on PATH or in the default Windows install folder.
TESSERACT_CMD=

# --- Upload limits (anything over a limit fails at ingest with a plain reason) ---
CITETALLY_MAX_FILE_MB=20
CITETALLY_MAX_PAGES=10
# Pixel cap for images and rendered pages, to defeat decompression bombs.
CITETALLY_MAX_IMAGE_PIXELS=40000000
# A PDF page with at least this many characters of text is read from its text layer.
CITETALLY_TEXT_LAYER_MIN_CHARS=80

# --- Grounding and parsing ---
# How closely printed text must match the page words (0 to 1). A changed digit never matches.
CITETALLY_GROUNDING_MATCH_THRESHOLD=0.85
# What a bare "$" means, and the date and number format used to resolve ambiguous values.
CITETALLY_DEFAULT_CURRENCY=USD
CITETALLY_LOCALE=en-US

# --- Checks ---
# An amount may differ from the arithmetic by this many minor units (cents) before it is flagged.
CITETALLY_MATH_TOLERANCE_MINOR=1
# Same vendor, total and currency within this many days is a suspected duplicate.
CITETALLY_DUPLICATE_DATE_WINDOW_DAYS=7
# An outlier needs this many approved entries for the vendor, and a total this many times the median.
CITETALLY_OUTLIER_MIN_HISTORY=5
CITETALLY_OUTLIER_RATIO=3
# An entry date older than this many days is flagged.
CITETALLY_MAX_AGE_DAYS=400
# Mean OCR confidence below this (0 to 100) is flagged as a poor read.
CITETALLY_LOW_CONFIDENCE=75
# Extra phrases that mark instruction-like text, separated by semicolons (plain text, not patterns).
CITETALLY_SUSPICIOUS_PHRASES=

# --- Web app ---
# The dev web app's port. The API refuses changes sent from any other website.
CITETALLY_WEB_PORT=5175

# --- Safety switches ---
# Hosted models are off by default. Hosted mode refuses to start unless this is true.
CITETALLY_ALLOW_HOSTED=false
# Shows the "Demo data" label in the UI. All data in this project is synthetic.
CITETALLY_SYNTHETIC_DATA=true
